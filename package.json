{
  "name": "wp-woocommerce-products-list",
  "version": "0.3.4",
  "private": true,
  "description": "A fast DataViews product catalog for WooCommerce",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "eslint resources tests/js",
    "lint:types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-woocommerce-products-list php -d memory_limit=1024M vendor/bin/phpunit --bootstrap tests/bootstrap.php --testsuite integration"
  },
  "dependencies": {
    "@wordpress/dataviews": "20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wordpress/api-fetch": "^7.57.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/date": "^5.57.0",
    "@wordpress/dom-ready": "^4.57.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^10.0.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/html-entities": "^4.57.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/icons": "^18.0.0",
    "@wordpress/notices": "^5.57.0",
    "@wordpress/preferences": "^4.57.0",
    "@wordpress/scripts": "~36.0.0",
    "@wordpress/url": "^4.57.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
